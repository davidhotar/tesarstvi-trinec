# PostgreSQL connection string
DATABASE_URL=postgresql://127.0.0.1:5432/tesarstvi-trinec

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs / scheduled publish
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate draft preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Resend API key for transactional email (forms, etc.)
RESEND_API_KEY=

# Google reviews via Featurable (free). Widget ID from Featurable dashboard > Embed > API.
# Optional — falls back to the ID baked into src/utilities/getGoogleReviews.ts if unset.
FEATURABLE_WIDGET_ID=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Optional — tracking is
# disabled when unset, so leave blank in local/preview environments.
NEXT_PUBLIC_GTM_ID=

# S3-compatible storage (Cloudflare R2, AWS S3, etc.)
# When set, media uploads go to the bucket instead of local disk.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto

mall":{"url":"/api/media/file/premium_photo-1681506194823-78ec4c4aa7f1-600x600.jpg","width":600,"height":600,"mimeType":"image/jpeg","filesize":65521,"filename":"premium_photo-1681506194823-78ec4c4aa7f1-600x600.jpg"},"medium":{"url":"/api/media/file/premium_photo-1681506194823-78ec4c4aa7f1-900x900.jpg","width":900,"height":900,"mimeType":"image/jpeg","filesize":119670,"filename":"premium_photo-1681506194823-78ec4c4aa7f1-900x900.jpg"},"large":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"xlarge":{"url":null,"width":null,"height":null,"mimeType":null,"filesize":null,"filename":null},"og":{"url":"/api/media/file/premium_photo-1681506194823-78ec4c4aa7f1-1200x630.jpg","width":1200,"height":630,"mimeType":"image/jpeg","filesize":103710,"filename":"premium_photo-1681506194823-78ec4c4aa7f1-1200x630.jpg"}}},"quote":"\"Dělám dřevo, protože mě to baví. Kdyby mě to přestalo bavit, dělám něco jiného.\" — Petr.","ctaLabel":"Zavolat Petrovi","ctaLink":"tel:+420737136848","blockName":"Profile Hero","badges":[{"id":"69f748d8d594c11437811962","label":"25+ let v řemesle","position":"top-left"},{"id":"69f748d8d594c11437811963","label":"Rodinná dílna","position":"bottom-right"}],"stats":[{"id":"69f748d8d594c11437811964","value":"25+","label":"let s dřevem v ruce"},{"id":"69f748d8d594c11437811965","value":"180","label":"hotových realizací"},{"id":"69f748d8d594c11437811966","value":"4.9★","label":"průměr Google recenzí"},{"id":"69f748d8d594c11437811967","value":"0","label":"reklamací za 3 roky"},{"id":"69f748d8d594c11437811968","value":"40 km","label":"okruh Třince"}],"blockType":"profileHeroSection"},{"id":"69f748d8d594c11437811970","title":"Cesta od učedníka k vlastní dílně.","blockName":"Timeline","milestones":[{"id":"69f748d8d594c1143781196a","year":"1998","title":"První hoblík","text":"Jako čtrnáctiletý kluk v dílně u dědy. Roubenka, která stojí dodnes."},{"id":"69f748d8d594c1143781196b","year":"2003","title":"Vyučení tesařem","text":"SOU stavební Frýdek-Místek. Práce na krovech v Beskydech."},{"id":"69f748d8d594c1143781196c","year":"2014","title":"Vlastní firma","text":"Z garáže přístavby u rodičů. První pergola — pro souseda. Stojí."},{"id":"69f748d8d594c1143781196d","year":"2019","title":"Dílna v Třinci","text":"Vlastní hala, CNC frézka, sklad modřínu. Tým se rozrostl o syna."},{"id":"69f748d8d594c1143781196e","year":"2024","title":"180. realizace","text":"Pergola pro rodinu z Bystřice. Pivo a děkujeme do týdne."},{"id":"69f748d8d594c1143781196f","year":"dnes","title":"Tým 4 lidí","text":"Stále malá rodinná dílna. Stále všechno dělám se synem."}],"blockType":"timelineSection"},{"id":"69f748d8d594c11437811975","title":"Čtyři věci, na kterých nehnu ani o píď.","subtitle":"Naše hodnoty","sideDescription":"Nejsou to slogany na zeď. Je to to, podle čeho denně rozhodujeme.","showConnector":false,"glowEffect":"bottom","blockName":"Values","items":[{"id":"69f748d8d594c11437811971","icon":null,"title":"Poctivý materiál","description":"Modřín, dub, smrk z Beskyd. Žádný brak, žádný eko-import. Vidíte fakturu z pily, kdykoli chcete."},{"id":"69f748d8d594c11437811972","icon":null,"title":"Tesařské spoje","description":"Tradiční vazby — čep, kampovka, rybinový spoj. Šroub až tam, kde má smysl. Konstrukce drží 80 let."},{"id":"69f748d8d594c11437811973","icon":null,"title":"Dimenze, ne zubní párátka","description":"Sloupy 14×14 cm minimum, krokve 8×16 cm. Pergola není tyčový plot — postavíme tak, aby unesla sníh."},{"id":"69f748d8d594c11437811974","icon":null,"title":"Základ jako u baráku","description":"Šroubovací piloty nebo betonové patky pod hladinu mrazu. Bez ulehčování. Bez \"však ono to udrží\"."}],"blockType":"numberedCardGrid"},{"id":"69f748d8d594c11437811980","subtitle":"Kde stavíme","title":"Třinec a 40 km kolem.","description":"Doma je doma. Stavíme tam, kde známe pily, řemeslníky a klienty. Když je projekt zajímavý, dojedeme i dál — ale bez slibování zázraků.","mapImage":null,"blockName":"Region","loca
{"docs":[{"id":15,"title":"Služby","layout":[{"id":"69f79c3bfa07d8cc7ab4ae72","eyebrow":"Naše služby","heading":"Tři věci, které děláme poctivě a celé.","note":"10 let · 142 realizací · MS kraj","ctaLabel":"Konzultace zdarma","ctaLink":"/kontakt","blockName":null,"blockType":"serviceHero"},{"id":"69f79c3bfa07d8cc7ab4ae86","number":"01","badge":"Bestseller · 60 % naší práce","badgeVariant":"accent","title":"Pergoly & terasy","description":"Klasické posezení, posuvná střecha nebo bioklima. Modřín, dub, smrk. Vše s 3D návrhem a poctivými vazbami. Postavíme i na svahu, na terase, na betonu i v zemi.","variant":"showcase","ctaLabel":"Chci nezávaznou nabídku","ctaLink":"/kontakt","background":"default","blockName":null,"subServices":[{"id":"69f79c3bfa07d8cc7ab4ae76","title":"Pergoly otevřené","description":"Klasická konstrukce, šikmá nebo plochá střecha. Ideál pro grilování a posezení.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae73","tag":"Modřín"},{"id":"69f79c3bfa07d8cc7ab4ae74","tag":"Dub"},{"id":"69f79c3bfa07d8cc7ab4ae75","tag":"Smrk"}]},{"id":"69f79c3bfa07d8cc7ab4ae7a","title":"Pergoly s posuvnou střechou","description":"Lamelová nebo posuvná. Stín nebo slunce — vy si vyberete.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae77","tag":"Hliník"},{"id":"69f79c3bfa07d8cc7ab4ae78","tag":"Dřevo"},{"id":"69f79c3bfa07d8cc7ab4ae79","tag":"Mix"}]},{"id":"69f79c3bfa07d8cc7ab4ae7e","title":"Terasy & podlahy","description":"Modřínová prkna, kompozit nebo termodřevo. Včetně podloží.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae7b","tag":"25 m²+"},{"id":"69f79c3bfa07d8cc7ab4ae7c","tag":"Zábradlí"},{"id":"69f79c3bfa07d8cc7ab4ae7d","tag":"Schody"}]}],"images":[],"blockType":"serviceDeepDive","checklist":{"heading":"V ceně vždy:","items":[{"id":"69f79c3bfa07d8cc7ab4ae7f","text":"3D návrh + vizualizace"},{"id":"69f79c3bfa07d8cc7ab4ae80","text":"Statický posudek"},{"id":"69f79c3bfa07d8cc7ab4ae81","text":"Doprava materiálu"},{"id":"69f79c3bfa07d8cc7ab4ae82","text":"Základy / kotvení"},{"id":"69f79c3bfa07d8cc7ab4ae83","text":"Montáž a úklid"},{"id":"69f79c3bfa07d8cc7ab4ae84","text":"Lazura/olej dle volby"},{"id":"69f79c3bfa07d8cc7ab4ae85","text":"Záruka 5 let na konstrukci"}]},"tip":{"text":null}},{"id":"69f79c3bfa07d8cc7ab4ae8d","number":"02","badge":"Praktická volba","badgeVariant":"default","title":"Přístřešky & garáže","description":"Pro auta, dřevo, traktor, chovatelské potřeby. Otevřené přístřešky i uzavřené garáže. Šindel, plech nebo bobrovka — pojďme vybrat.","variant":"gallery","ctaLabel":"Chci nabídku na přístřešek","ctaLink":"/kontakt","background":"muted","blockName":null,"subServices":[],"images":[],"blockType":"serviceDeepDive","checklist":{"heading":"Co stavíme:","items":[{"id":"69f79c3bfa07d8cc7ab4ae87","text":"Přístřešek 1 auto"},{"id":"69f79c3bfa07d8cc7ab4ae88","text":"Přístřešek 2 auta (nejčastější)"},{"id":"69f79c3bfa07d8cc7ab4ae89","text":"Přístřešek 3–4 auta + dílna"},{"id":"69f79c3bfa07d8cc7ab4ae8a","text":"Uzavřená garáž s vraty"},{"id":"69f79c3bfa07d8cc7ab4ae8b","text":"Přístřešek na dřevo"},{"id":"69f79c3bfa07d8cc7ab4ae8c","text":"Stojan na kola/koloběžky"}]},"tip":{"text":"Přístřešek na 2 auta s technickou místností (kola, sekačka, dřevo) — to je nejlepší poměr cena/užitek. Mluvte si o ní s námi."}},{"id":"69f79c3bfa07d8cc7ab4ae9e","number":"03","badge":"Na míru","badgeVariant":"default","title":"Dřevostavby & domky","description":"Zahradní domky, sklady, sauny, pracovny, hostovské tiny domky. Klasický roubený styl i čistý moderní design. Do 25 m² bez ohlášky, větší stavby s naším projektantem.","variant":"showcase","ctaLabel":"Chci dřevostavbu na míru","ctaLink":"/kontakt","background":"default","blockName":null,"subServices":[{"id":"69f79c3bfa07d8cc7ab4ae90","title":"Zahradní domek","description":"Roubený styl nebo moderní design. Od 4x3 m.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae8e","tag":"Modřín"},{"id":"69f79c3bfa07d8cc7ab4ae8f","tag":"Smrk"}]},{"id":"69f79c3bfa07d8cc7ab4ae93","title":"Sauna venkovní","description":"Na 2-4 osoby. Kompletní včetně vybavení.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae91","tag":"Finská"},{"id":"69f79c3bfa07d8cc7ab4ae92","tag":"Sudová"}]},{"id":"69f79c3bfa07d8cc7ab4ae96","title":"Pracovna v zahradě","description":"Zateplená, celoroční. Ideální jako home office.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae94","tag":"Zateplená"},{"id":"69f79c3bfa07d8cc7ab4ae95","tag":"Elektřina"}]},{"id":"69f79c3bfa07d8cc7ab4ae99","title":"Sklad / dílna","description":"Praktické řešení do 25 m² bez ohlášky.","tags":[{"id":"69f79c3bfa07d8cc7ab4ae97","tag":"Do 25 m²"},{"id":"69f79c3bfa07d8cc7ab4ae98","tag":"Ohlášení"}]}],"images":[],"blockType":"serviceDeepDive","checklist":{"heading":"Součástí každé stavby:","items":[{"id":"69f79c3bfa07d8cc7ab4ae9a","text":"Zaměření a projekt"},{"id":"69f79c3bfa07d8cc7ab4ae9b","text":"Výběr materiálu"},{"id":"69f79c3bfa07d8cc7ab4ae9c","text":"Kompletní realizace"},{"id":"69f79c3bfa07d8cc7ab4ae9d","text":"Pomoc s ohláškou/povolením"}]},"tip":{"text":null}},{"id":"69f79c3bfa07d8cc7ab4ae9f","title":"Nevíte, co potřebujete?","description":"Zavolejte. Pavel vám za 5 minut řekne, co je pro vás nejlepší.","ctaLabel":"Zavolat","ctaLink":"tel:+420737136848","ratingText":null,"blockName":null,"blockType":"ctaBanner"},{"id":"69f79c3bfa07d8cc7ab4aea5","title":"To, co se ptáte.","description":"Otázky ke službám","blockName":null,"faqs":[{"id":"69f79c3bfa07d8cc7ab4aea0","question":"Jaký je rozdíl mezi pergolou a přístřeškem?","answer":"Pergola = posezení, často vedle domu, otevřená. Přístřešek = kryje něco konkrétního (auto, dřevo). Konstrukčně jsou si blízko, my je děláme oboje."},{"id":"69f79c3bfa07d8cc7ab4aea1","question":"Co všechno je v ceně?","answer":"Vždy návrh, materiál, doprava, montáž a finální povrchovou úpravu. Konkrétní rozsah závisí na typu stavby — vše vám upřesníme v nabídce."},{"id":"69f79c3bfa07d8cc7ab4aea2","question":"Postavíte i mimo Třinec?","answer":"Ano, stavíme po celém Moravskoslezském kraji. Nejčastěji Třinec, Frýdek-Místek, Český Těšín a okolí."},{"id":"69f79c3bfa07d8cc7ab4aea3","question":"Můžu si vybrat dřevo přímo na pile?","answer":"Samozřejmě. Rádi vás vezmeme na pilu, kde si materiál vyberete osobně."},{"id":"69f79c3bfa07d8cc7ab4aea4","question":"Co když chci kombinaci (pergola + přístřešek)?","answer":"To děláme běžně. Často je to i výhodnější — ušetříte na společných základech a konstrukci."}],"blockType":"faqSection"}],"meta":{"title":"Služby | Tesařství Třinec","image":null,"description":"Pergoly, přístřešky a dřevostavby na míru. Rodinná tesařská firma z Třince s více než 10 lety zkušeností."},"publishedAt":null,"generateSlug":false,"slug":"sluzby","updatedAt":"2026-05-03T19:04:27.540Z","createdAt":"2026-05-03T19:03:36.842Z","_status":"published"},{"id":14,"title":"O nás","layout":[{"id":"69f748d8d594c11437811969","tagline":"od roku 2014","richText":{"root":{"type":"root","format":"","indent":0,"version":1,"children":[{"tag":"h1","type":"heading","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Dřevo, tradice, a chlap, co se za to ","type":"text","format":0,"version":1},{"mode":"normal","text":"podepíše.","type":"text","format":1,"version":1}],"direction":"ltr"},{"type":"paragraph","format":"","indent":0,"version":1,"children":[{"mode":"normal","text":"Jsem Petr a tesařině se věnuju přes 25 let. Učil jsem se u starých mistrů v Beskydech, dnes vedu malou rodinnou dílnu v Třinci. Stavím tak, jak bych chtěl, aby někdo postavil mně doma.","type":"text","format":0,"version":1}],"direction":"ltr"}],"direction":"ltr"}},"personName":"Petr Czempka","personTitle":"Tesař & majitel · Třinec","personImage":{"id":222,"alt":null,"caption":null,"folder":null,"updatedAt":"2026-05-03T20:13:09.611Z","createdAt":"2026-05-03T20:13:08.632Z","url":"/api/media/file/profile-4JSlnCdY3G4vwlctqeejdq4wwtpyMe.jpg","thumbnailURL":"/api/media/file/profile-300x300.jpg","filename":"profile-4JSlnCdY3G4vwlctqeejdq4wwtpyMe.jpg","mimeType":"image/jpeg","filesize":37254,"width":334,"height":334,"focalX":50,"focalY":50,"s